# Flask
SECRET_KEY=change-me-in-production

# Storage. DATA_DIR is the parent; UPLOAD_DIR / PROCESSED_DIR / the SQLite
# file default to subpaths of it. Override individually if you need to.
DATA_DIR=/app/data
UPLOAD_DIR=/app/data/uploads
PROCESSED_DIR=/app/data/processed

# Database (defaults to sqlite at $DATA_DIR/app.db)
DATABASE_URL=sqlite:////app/data/app.db

# Upload limit
MAX_UPLOAD_MB=50
